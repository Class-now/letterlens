{
  "name": "letterlens",
  "version": "0.1.0",
  "private": true,
  "description": "AI that explains Japanese official letters to foreign residents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/web/app.ts --bundle --format=esm --target=es2022 --loader:.txt=text --outfile=public/app.js",
    "dev": "wrangler dev -c wrangler.offline.jsonc --port 8799",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "render-samples": "node scripts/render-samples.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true
  }
}
